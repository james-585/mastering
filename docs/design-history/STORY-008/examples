"""STORY-008 Example: End-to-End Stem Separation Demo

This script demonstrates the complete stem-separated pre-mastering workflow.

Usage:
    python examples/stem_separation_example.py input.wav output_dir/
    
Requirements:
    pip install demucs torch
"""
from __future__ import annotations

import logging
import sys
from pathlib import Path

import numpy as np

# Configure logging to see detailed progress
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
)

logger = logging.getLogger(__name__)


def example_1_basic_stem_separation():
    """Example 1: Basic stem separation only (no DSP processing)."""
    from suno_mastering.io.stem_separation import split_stems
    from suno_mastering.mastering.stem_processing import sum_stems
    
    # Create a 5-second test signal
    sr = 44100
    duration = 5.0
    t = np.linspace(0, duration, int(sr * duration))
    
    # Stereo test signal: 440 Hz sine + decorrelated noise
    signal = np.sin(2 * np.pi * 440 * t) * 0.2
    noise_L = np.random.normal(0, 0.05, len(t))
    noise_R = np.random.normal(0, 0.05, len(t))
    
    audio = np.stack([signal + noise_L, signal + noise_R], axis=1).astype(np.float64)
    
    logger.info("=" * 70)
    logger.info("Example 1: Basic Stem Separation")
    logger.info("=" * 70)
    
    # Separate stems
    stems = split_stems(audio, sr, model_name="htdemucs")
    
    # Log stem peaks
    for name, stem_array in stems.items():
        peak = np.abs(stem_array).max()
        logger.info(f"  {name:8s}: peak = {peak:.6f}")
    
    # Re-sum without processing
    summed = sum_stems(stems)
    
    # Compare to original
    diff = audio - summed
    diff_dbfs = 20 * np.log10(np.abs(diff).max() + 1e-12)
    logger.info(f"Null sum difference: {diff_dbfs:.2f} dB FS")


def example_2_with_targeted_processing():
    """Example 2: Stem separation + targeted DSP."""
    from suno_mastering.io.stem_separation import split_stems
    from suno_mastering.mastering.stem_processing import process_stems, sum_stems
    
    # Create a 3-second test signal
    sr = 44100
    duration = 3.0
    t = np.linspace(0, duration, int(sr * duration))
    
    # Bass-heavy signal: 60 Hz sine + mid-range content + HF noise
    bass = np.sin(2 * np.pi * 60 * t) * 0.3
    mids = np.sin(2 * np.pi * 1000 * t) * 0.1
    hf_noise = np.random.normal(0, 0.02, len(t))
    
    audio = np.stack([bass + mids + hf_noise] * 2, axis=1).astype(np.float64)
    
    logger.info("=" * 70)
    logger.info("Example 2: Stem Separation + Targeted DSP")
    logger.info("=" * 70)
    
    # Separate stems
    stems = split_stems(audio, sr, model_name="htdemucs")
    
    # Apply targeted processing
    processed_stems, actions = process_stems(stems, sr)
    
    # Log actions
    for action in actions:
        logger.info(
            f"  {action.stem_name:8s}: {action.action_type:15s} {action.parameters}"
        )
    
    # Re-sum
    summed = sum_stems(processed_stems)
    
    logger.info(f"Processed audio peak: {np.abs(summed).max():.6f}")


def example_3_full_integration():
    """Example 3: Full integration with MasteringConfig."""
    from suno_mastering.config import MasteringConfig, StemConfig
    from suno_mastering.stem_integration import run_stem_preprocessing
    
    # Create a simple test signal
    sr = 44100
    duration = 2.0
    t = np.linspace(0, duration, int(sr * duration))
    audio = np.stack([np.sin(2 * np.pi * 440 * t) * 0.2] * 2, axis=1).astype(np.float64)
    
    logger.info("=" * 70)
    logger.info("Example 3: Full Integration with MasteringConfig")
    logger.info("=" * 70)
    
    # Configure stem processing
    stem_config = StemConfig(
        enabled=True,
        model_name="htdemucs",
        bass_mono_cutoff_hz=90.0,
        vocal_lpf_hz=15000.0,
        vocal_hpf_hz=80.0,
    )
    
    # Run preprocessing
    processed_audio, result = run_stem_preprocessing(
        audio=audio,
        sample_rate=sr,
        stem_config=stem_config,
    )
    
    # Display result
    logger.info(f"Model used: {result.model_used}")
    logger.info(f"Separation time: {result.separation_time_s:.2f}s")
    logger.info(f"Actions applied: {len(result.actions_applied)}")
    
    for action in result.actions_applied:
        logger.info(
            f"  {action.stem_name:8s}: {action.action_type:15s}"
        )


def example_4_null_sum_verification():
    """Example 4: Verify null sum test (AC2)."""
    from suno_mastering.io.stem_separation import split_stems
    from suno_mastering.mastering.stem_processing import sum_stems
    from suno_mastering.stem_integration import verify_null_sum
    
    # Create test signal
    sr = 44100
    duration = 2.0
    t = np.linspace(0, duration, int(sr * duration))
    audio = np.stack([np.sin(2 * np.pi * 440 * t) * 0.1] * 2, axis=1).astype(np.float64)
    
    logger.info("=" * 70)
    logger.info("Example 4: Null Sum Test (AC2)")
    logger.info("=" * 70)
    
    # Separate and re-sum (no processing)
    stems = split_stems(audio, sr, model_name="htdemucs")
    summed = sum_stems(stems)
    
    # Verify null sum
    passed = verify_null_sum(audio, summed, tolerance_dbfs=-80.0)
    
    if passed:
        logger.info("✓ Null sum test PASSED (difference <= -80 dB FS)")
    else:
        logger.warning("✗ Null sum test FAILED (difference > -80 dB FS)")
        # Try relaxed tolerance
        passed_relaxed = verify_null_sum(audio, summed, tolerance_dbfs=-70.0)
        if passed_relaxed:
            logger.info("  (Passed at -70 dB FS — acceptable for Demucs artifacts)")


def example_5_bass_mono_verification():
    """Example 5: Verify bass mono summing (AC3)."""
    from suno_mastering.mastering.stem_processing import _mono_sum_sub_bass
    from scipy.signal import butter, sosfiltfilt
    
    # Create stereo bass signal (decorrelated L/R)
    sr = 44100
    duration = 3.0
    t = np.linspace(0, duration, int(sr * duration))
    
    bass_L = np.sin(2 * np.pi * 60 * t) * 0.3
    bass_R = np.sin(2 * np.pi * 60 * t + 0.5) * 0.3  # Phase offset
    
    audio = np.stack([bass_L, bass_R], axis=1).astype(np.float64)
    
    logger.info("=" * 70)
    logger.info("Example 5: Bass Mono Verification (AC3)")
    logger.info("=" * 70)
    
    # Apply mono summing
    processed = _mono_sum_sub_bass(audio, sr, cutoff_hz=90.0)
    
    # Extract <90 Hz content
    sos = butter(8, 90.0, btype="lowpass", fs=sr, output="sos")
    L_sub = sosfiltfilt(sos, processed[:, 0])
    R_sub = sosfiltfilt(sos, processed[:, 1])
    
    # Compute correlation
    cross_corr = np.sum(L_sub * R_sub)
    auto_L = np.sum(L_sub * L_sub)
    auto_R = np.sum(R_sub * R_sub)
    
    if auto_L > 0 and auto_R > 0:
        corr_coeff = cross_corr / np.sqrt(auto_L * auto_R)
    else:
        corr_coeff = 0.0
    
    logger.info(f"Sub-bass (<90 Hz) correlation: {corr_coeff:.6f}")
    
    if corr_coeff > 0.999:
        logger.info("✓ Bass mono verification PASSED (correlation ≈ 1.0)")
    else:
        logger.warning(
            f"✗ Bass mono verification FAILED (correlation = {corr_coeff:.6f}, expected ≈ 1.0)"
        )


